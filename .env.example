# ACEVA Web Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT commit .env.local or raw API keys to Git repository!
#
# ── What each runtime needs (Pulse) ─────────────────────────────────────────
# Vercel preview builds run with NODE_ENV=production, so they get production
# rules: Turnstile required, Postgres-backed rate limits that fail closed.
#
#                                   production      preview          local dev
#   OPENAI_API_KEY                  required        required         required
#   DATABASE_URL                    prod database   non-prod branch  non-prod branch
#   PULSE_DB_ENDPOINT               prod endpoint   that branch      that branch
#   PULSE_DB_PRODUCTION_ENDPOINT    prod (pins it)  required         required
#   TURNSTILE_SECRET_KEY            required        required         optional
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY  required*       required*        optional
#   TURNSTILE_EXPECTED_HOSTNAME     required        preview host     optional
#   CONTACT_REQUIRE_TURNSTILE       true            true             false
#   RESEND_API_KEY                  required        optional         optional
#   CONTACT_FROM_EMAIL              verified sender optional         optional
#   NEXT_PUBLIC_SITE_URL            https://...     optional         localhost
#   PULSE_SHARED_STORES             leave unset     leave unset      optional
#   * build-time: changing it needs a redeploy, not just a restart.
#
# Missing any "required" Pulse value makes the feature fail closed (503 or a
# refused save), never open. Exception: the contact form skips Turnstile when
# TURNSTILE_SECRET_KEY is unset unless CONTACT_REQUIRE_TURNSTILE=true.
# Local dev must never use the production database: the guard refuses it.
# Optional everywhere: OPENAI_MODEL, EMBEDDING_MODEL, CONTACT_TO_EMAIL,
# TURNSTILE_EXPECTED_ACTION, PULSE_VERIFY_TOKEN_TTL_MINUTES, PULSE_ID_MAX_AGE_DAYS,
# PULSE_DISABLE_TURN_LOG=1 (QA: no chat_turns writes), TRUST_PROXY_HEADERS,
# MOBILE_PREVIEW_USERNAME / MOBILE_PREVIEW_PASSWORD (/mobile preview; 404 without),
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION.

# Public site URL — REQUIRED IN PRODUCTION.
# Drives canonical URLs, the sitemap, robots.txt and the Organization schema.
# Include the protocol and NO trailing slash. If this is unset the app silently falls
# back to https://acevatech.com, which is correct today but will point the entire SEO
# surface at the wrong host if the domain ever changes.
NEXT_PUBLIC_SITE_URL=https://acevatech.com

# Google Search Console verification (optional).
# Search Console → Add property → HTML tag → copy ONLY the content="..." value here.
# Leave blank until you verify; the tag is omitted entirely when unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# OpenAI API Configuration (Primary LLM Provider)
# EMBEDDING_MODEL also runs on this key. Changing it invalidates the vector
# index: lib/pulse/vectorStore.ts refuses to load an index built with a
# different model, so re-run `npm run build:index` after any change.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Local development: set NEXT_PUBLIC_SITE_URL above to http://localhost:3000 instead.

# Required in production — get a key at https://resend.com
RESEND_API_KEY=re_your_real_key_here

# Use a sender domain verified in Resend. Do not use onboarding@resend.dev in production.
CONTACT_TO_EMAIL=contact@acevatech.com
CONTACT_FROM_EMAIL=Aceva Website <website@acevatech.com>

# Cloudflare Turnstile — spam protection on the contact form.
# If NEXT_PUBLIC_TURNSTILE_SITE_KEY is missing the widget silently does not render and
# the form ships without spam filtering, so set these in production.
# Keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Keep disabled locally until a Cloudflare Turnstile widget is configured.
# In production, use a matching site/secret key pair and set this to true.
CONTACT_REQUIRE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=contact

# Neon PostgreSQL Database — REQUIRED for Aceva Pulse.
# Backs the `directions` table that stores saved project directions and the
# visitor contact details attached to them (lib/pulse/directionStore.ts).
# Without it /api/pulse/save-direction returns 503 and PULSE ID lookup finds
# nothing. Provision the table with: npm run migrate:directions
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database target guard (lib/pulse/dbTarget.ts) — REQUIRED wherever DATABASE_URL is used.
# Values are Neon endpoint ids from the connection host (e.g. ep-name-123456), not secrets.
# Production: PULSE_DB_ENDPOINT = the production endpoint.
# Preview and local: PULSE_DB_ENDPOINT = your own branch's endpoint, and
# PULSE_DB_PRODUCTION_ENDPOINT = the production endpoint, which is then refused.
# PULSE_DB_ALLOW_PRODUCTION=1 lets an operator script reach production from a
# workstation only; it is ignored on Vercel.
PULSE_DB_ENDPOINT=
PULSE_DB_PRODUCTION_ENDPOINT=
PULSE_DB_ALLOW_PRODUCTION=

# Pulse security (P1). Turnstile is always required in production for Pulse saves.
# PULSE_REQUIRE_TURNSTILE=false skips it outside production only.
PULSE_REQUIRE_TURNSTILE=
PULSE_VERIFY_TOKEN_TTL_MINUTES=
PULSE_ID_MAX_AGE_DAYS=
# postgres | memory. Defaults to postgres in production builds, memory elsewhere.
PULSE_SHARED_STORES=
# Trust x-real-ip / x-forwarded-for off Vercel, behind a proxy you control.
TRUST_PROXY_HEADERS=

# Public production origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://example.com

# Required in production — get a key at https://resend.com
RESEND_API_KEY=

# Use a sender domain verified in Resend. Do not use onboarding@resend.dev in production.
CONTACT_TO_EMAIL=acevatechnology@gmail.com
CONTACT_FROM_EMAIL=Aceva Website <website@example.com>

# Cloudflare Turnstile — get keys at https://dash.cloudflare.com/?to=/:account/turnstile
CONTACT_REQUIRE_TURNSTILE=true
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=example.com
TURNSTILE_EXPECTED_ACTION=contact

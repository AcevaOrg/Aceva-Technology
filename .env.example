# ACEVA Web Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT commit .env.local or raw API keys to Git repository!

# OpenAI API Configuration (Primary LLM Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Required in production — get a key at https://resend.com
RESEND_API_KEY=your_resend_apu_key_here

# Use a sender domain verified in Resend. Do not use onboarding@resend.dev in production.
CONTACT_TO_EMAIL=acevatech.official@gmail.com
CONTACT_FROM_EMAIL=Aceva Website <website@acevatech.com>

# Neon PostgreSQL Database (Optional / Analytics)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

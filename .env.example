# ACEVA Web Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT commit .env.local or raw API keys to Git repository!

# Public site URL — REQUIRED IN PRODUCTION.
# Drives canonical URLs, the sitemap, robots.txt and the Organization schema.
# Include the protocol and NO trailing slash. If this is unset the app silently falls
# back to https://acevatech.com, which is correct today but will point the entire SEO
# surface at the wrong host if the domain ever changes.
NEXT_PUBLIC_SITE_URL=https://acevatech.com

# Google Search Console verification (optional).
# Search Console → Add property → HTML tag → copy ONLY the content="..." value here.
# Leave blank until you verify; the tag is omitted entirely when unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# OpenAI API Configuration (Primary LLM Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Required in production — get a key at https://resend.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=re_your_real_key_here

# Use a sender domain verified in Resend. Do not use onboarding@resend.dev in production.
CONTACT_TO_EMAIL=acevatech.official@gmail.com
CONTACT_FROM_EMAIL=Aceva Website <website@acevatech.com>

# Cloudflare Turnstile — spam protection on the contact form.
# If NEXT_PUBLIC_TURNSTILE_SITE_KEY is missing the widget silently does not render and
# the form ships without spam filtering, so set these in production.
# Keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Keep disabled locally until a Cloudflare Turnstile widget is configured.
# In production, use a matching site/secret key pair and set this to true.
CONTACT_REQUIRE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=contact

# Neon PostgreSQL Database (Optional / Analytics)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ACEVA Web Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT commit .env.local or raw API keys to Git repository!

# Public site URL — REQUIRED IN PRODUCTION.
# Drives canonical URLs, the sitemap, robots.txt and the Organization schema.
# Include the protocol and NO trailing slash. If this is unset the app silently falls
# back to https://acevatech.com, which is correct today but will point the entire SEO
# surface at the wrong host if the domain ever changes.
NEXT_PUBLIC_SITE_URL=https://acevatech.com

# Google Search Console verification (optional).
# Search Console → Add property → HTML tag → copy ONLY the content="..." value here.
# Leave blank until you verify; the tag is omitted entirely when unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# OpenAI API Configuration (Primary LLM Provider)
# EMBEDDING_MODEL also runs on this key. Changing it invalidates the vector
# index: lib/pulse/vectorStore.ts refuses to load an index built with a
# different model, so re-run `npm run build:index` after any change.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Required in production — get a key at https://resend.com
# (NEXT_PUBLIC_SITE_URL is set once, at the top of this file. For local development you can override it
# in .env.local with http://localhost:3000, but never in Vercel: the QR codes on documents use it.)
RESEND_API_KEY=re_your_real_key_here

# Use a sender domain verified in Resend. Do not use onboarding@resend.dev in production.
CONTACT_TO_EMAIL=contact@acevatech.com
CONTACT_FROM_EMAIL=Aceva Website <website@acevatech.com>

# Cloudflare Turnstile — spam protection on the contact form.
# If NEXT_PUBLIC_TURNSTILE_SITE_KEY is missing the widget silently does not render and
# the form ships without spam filtering, so set these in production.
# Keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Keep disabled locally until a Cloudflare Turnstile widget is configured.
# In production, use a matching site/secret key pair and set this to true.
CONTACT_REQUIRE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=contact

# Neon PostgreSQL Database — REQUIRED for Aceva Pulse.
# Backs the `directions` table that stores saved project directions and the
# visitor contact details attached to them (lib/pulse/directionStore.ts).
# Without it /api/pulse/save-direction returns 503 and PULSE ID lookup finds
# nothing. Provision the table with: npm run migrate:directions
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Internal admin console (/admin) and the document registry
# ---------------------------------------------------------------------------
# The console is reached only by typing /admin on the real site. Nothing public links to it, it is
# absent from robots.txt and the sitemap, and the Pulse chatbot never mentions it.

# The pass key that unlocks /admin. REQUIRED to enable the console: with it unset (or shorter
# than 8 characters) every /admin and /api/admin URL answers 404, as if it did not exist.
# A short key (8+ characters) is accepted on purpose. What makes that tolerable is the lockout:
# 5 wrong tries in 15 minutes lock that address out, doubling on each repeat up to 24 hours, kept
# in Postgres so it survives restarts. A LONG random key is still far stronger, so use one:
#   npm run admin:passkey      (prints a 24-character key; nothing is written to disk)
# Set it for the Production environment only. A deployment without it has no console at all,
# which is the simplest way to keep preview deployments out.
ADMIN_PASSKEY=

# Hosts the console may answer on: comma-separated BARE host names, for example
#   ADMIN_ALLOWED_HOSTS=acevatech.com,www.acevatech.com
# RECOMMENDED IN PRODUCTION. Any /admin or /api/admin request whose Host header is not listed gets
# the same 404 as a disabled console, so a preview or alias URL such as something.vercel.app cannot
# even show the login page. Case, ports and a trailing dot are ignored. Entries that are not plain
# host names (a scheme, a path, a wildcard) are dropped. If NOTHING valid is left, for example
# "https://acevatech.com", the console is locked for every host instead of being opened, so test
# it after changing this. When the variable is unset or blank there is NO host restriction.
# localhost, 127.0.0.1 and [::1] are always allowed outside production (next dev); a production
# build (next start, Vercel) refuses them unless they are listed. X-Forwarded-Host is consulted
# only when the Host header is missing. Preview deployments run as production builds, so they are
# locked out only if this variable is also set for the Preview environment.
ADMIN_ALLOWED_HOSTS=

# Optional, 32+ characters. Signs the admin session cookie. When empty it is derived from
# ADMIN_PASSKEY, so changing the pass key also signs every admin out. Set it to rotate sessions
# without changing the pass key.
ADMIN_SESSION_SECRET=

# How long an admin sign-in lasts, in hours (1-72). Default 8.
ADMIN_SESSION_HOURS=8

# Largest upload accepted per request, in megabytes (1-4, default 4). Vercel rejects request
# bodies over 4.5 MB before the app runs, so values above 4 are clamped.
ADMIN_MAX_UPLOAD_MB=4

# Local development only: set to 1 to run the document registry on an embedded Postgres stored in
# .local-db/ so you need no DATABASE_URL. Ignored (and refused) when NODE_ENV=production.
# Documents and uploads are stored in the same DATABASE_URL Neon database as Aceva Pulse:
#   npm run migrate:documents   (tables are also created lazily on first use)
ACEVA_LOCAL_DB=
